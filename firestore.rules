rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helper Functions ---
    
    // Check if user is signed in
    function isSignedIn() {
      return request.auth != null;
    }

    // Check if user is the owner of the document based on auth uid
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Email checks for extra robust auth (supports case insensitivity)
    function isEmailAdmin() {
      return request.auth != null && 'email' in request.auth.token && (
        request.auth.token.email.toLowerCase() == 'admin@lphalghazali.com' ||
        request.auth.token.email.toLowerCase() == 'asngad@mhs.unugha.ac.id'
      );
    }

    function isEmailAuditor() {
      return request.auth != null && 'email' in request.auth.token && 
        request.auth.token.email.toLowerCase() == 'auditor@lphalghazali.com';
    }

    function isEmailEditor() {
      return request.auth != null && 'email' in request.auth.token && 
        request.auth.token.email.toLowerCase() == 'editor@lphalghazali.com';
    }

    function isEmailStaf() {
      return request.auth != null && 'email' in request.auth.token && 
        request.auth.token.email.toLowerCase() == 'staf@lphalghazali.com';
    }

    // Check if user document lists a specific role
    function hasRoleInDocument(targetRole) {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == targetRole;
    }

    // Specific roles checking
    function isAdmin() {
      return isSignedIn() && (isEmailAdmin() || (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'));
    }

    function isAuditor() {
      return isSignedIn() && (isEmailAuditor() || (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'auditor'));
    }

    function isEditor() {
      return isSignedIn() && (isEmailEditor() || (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'editor'));
    }

    function isStaf() {
      return isSignedIn() && (isEmailStaf() || (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'staf'));
    }

    // Global staff check (fits duty functions)
    function isStaff() {
      return isAdmin() || isAuditor() || isEditor() || isStaf();
    }

    // --- Collection Matches ---

    // 1. Users Collection
    match /users/{userId} {
      allow read: if isSignedIn() && (isOwner(userId) || isStaff());
      allow write: if isSignedIn() && (isOwner(userId) || isAdmin());
    }

    // 2. Artifacts & Public Data
    match /artifacts/{appId} {
      allow read: if true;

      // Public data nested structure
      match /public/data/{collectionName}/{docId} {
        // Allow public read for news, regulations, and documents
        allow read: if collectionName in ['berita', 'regulasi', 'dokumen'] || 
                     (collectionName == 'pengajuan_halal' && isSignedIn() && (isStaff() || (resource != null && resource.data.userId == request.auth.uid)));
        
        // Write access for staff
        allow write: if isSignedIn() && isStaff();
        
        // Special logic for creating pengajuan (users can create their own)
        allow create: if collectionName == 'pengajuan_halal' && isSignedIn() && request.resource.data.userId == request.auth.uid;
        
        // Special logic for updating pengajuan (users can update their own if status doesn't change)
        allow update: if collectionName == 'pengajuan_halal' && isSignedIn() && 
                        (isStaff() || (resource.data.userId == request.auth.uid && request.resource.data.status == resource.data.status));
      }

      // Public system settings
      match /public/system_settings {
        allow read: if true;
        allow write: if isSignedIn() && isStaff();
      }
    }
  }
}
